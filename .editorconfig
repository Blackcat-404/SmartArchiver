root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,slnx,axaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Generated by "dotnet ef migrations add".
[src/SmartArchiver.Data/Migrations/**.cs]
generated_code = true

# E_MAGIC, E_LENGTH, ... are the names the methodology uses.
[src/SmartArchiver.Core/ErrorCode.cs]
dotnet_diagnostic.CA1707.severity = none

# Test names follow Method_Scenario_Expected.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
