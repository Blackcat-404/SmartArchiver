<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>smartarchiver</AssemblyName>
    <RootNamespace>SmartArchiver.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartArchiver.Core\SmartArchiver.Core.csproj" />
    <ProjectReference Include="..\SmartArchiver.Data\SmartArchiver.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.Local.json holds the personal connection string and is ignored by git. -->
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
